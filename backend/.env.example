NODE_ENV=development
PORT=3000
# Local development only. Set unique credentials for deployment.
DATABASE_URL=postgresql://codereviewer:local-development-only@localhost:5432/codereviewer?schema=public
# Required: generate using openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=2mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
MODEL_API_URL=http://localhost:8000/v1/chat/completions
MODEL_NAME=codereviewer
MODEL_API_KEY=
MODEL_TIMEOUT=120000
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=2048
MODEL_MAX_CONCURRENT=2
MODEL_MAX_RESPONSE_BYTES=1000000
REVIEW_PROMPT_PATH=
