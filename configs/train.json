{
  "data": {
    "dataset_path": "../datasets",
    "conversation_column": "messages"
  },
  "model": {
    "model_name": "Qwen/Qwen2-1.5B-Instruct",
    "max_seq_length": 1024,
    "load_in_4bit": true,
    "lora_rank": 16,
    "lora_alpha": 16,
    "lora_dropout": 0.0,
    "seed": 42,
    "backend": "peft",
    "use_gradient_checkpointing": "standard"
  },
  "training": {
    "output_dir": "../outputs/qwen2-1.5B-codereviewer",
    "num_train_epochs": 3,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 16,
    "learning_rate": 0.0002,
    "weight_decay": 0.01,
    "warmup_ratio": 0.03,
    "lr_scheduler_type": "cosine",
    "bf16": true,
    "fp16": false,
    "report_to": "none",
    "seed": 42
  }
}
